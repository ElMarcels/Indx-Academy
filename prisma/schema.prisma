generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Submodules ──────────────────────────────────────

model Submodule {
  id        String   @id @default(cuid())
  title     String
  order     Int
  moduleId  String
  createdAt DateTime @default(now())

  module   Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@unique([moduleId, order])
}

// ─── Course-Specific Flashcards ──────────────────────

model CourseFlashcard {
  id        String   @id @default(cuid())
  term      String
  definition String
  example   String?
  order     Int      @default(0)
  courseId   String
  createdAt DateTime @default(now())

  course   Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviews  CourseFlashcardReview[]

  @@unique([courseId, order])
}

model CourseFlashcardReview {
  id           String   @id @default(cuid())
  userId       String
  flashcardId  String
  quality      Int
  interval     Int
  easeFactor   Float
  nextReview   DateTime
  reviewCount  Int      @default(0)
  lastReviewed DateTime?
  createdAt    DateTime @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard CourseFlashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
}

// ─── Course Teachers ─────────────────────────────────

model CourseTeacher {
  id        String   @id @default(cuid())
  courseId   String
  userId    String
  role      String   @default("TEACHER") // TEACHer | ASSISTANT
  addedAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

// ─── AI Assistant Conversations ──────────────────────

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  courseId   String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user | assistant
  content        String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image     String?   @map("avatarUrl")
  bio       String?   @map("profileBio")
  role          String    @default("STUDENT") // STUDENT | ADMIN
  interests     String?   // JSON array of interest tags
  pushSubscription String? // JSON push subscription for web notifications
  lastSeen      DateTime? // Last activity for online status
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  enrollments      Enrollment[]
  lessonProgress   LessonProgress[]
  quizAttempts     QuizAttempt[]
  challengeSubmissions ChallengeSubmission[]
  comments         Comment[]
  achievements     UserAchievement[]
  sentMessages     Message[]          @relation("SentMessages")
  receivedMessages Message[]          @relation("ReceivedMessages")
  groupMemberships GroupMembership[]
  createdCourses   Course[]           @relation("CourseAuthor")
  createdGroups    Group[]
  contacts         Contact[]          @relation("ContactOwner")
  contactOf        Contact[]          @relation("ContactTarget")
  certificates     Certificate[]
  notifications    UserNotification[]
  peerMatches      PeerMatch[]        @relation("PeerUser")
  peerOf           PeerMatch[]        @relation("PeerTarget")
  callSessions     CallSession[]
  forumPosts       ForumPost[]
  forumReplies     ForumReply[]
  groupInvites     GroupInvite[]
  reactions        Reaction[]
  reports          Report[]          @relation("ReportReporter")
  reviewedReports  Report[]          @relation("ReportReviewer")
  flashcardReviews FlashcardReview[]
  surveyResponses  SurveyResponse[]
  pathQuizResults  PathQuizResult[]
  projectMemberships ProjectMember[]
  createdProjects    CollaborativeProject[]
  courseTeachers  CourseTeacher[]
  aiConversations AIConversation[]
  courseFlashcardReviews CourseFlashcardReview[]
  onboarding       UserOnboarding?
  staffMessages    StaffMessage[]
}

// ─── Courses ────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  thumbnail   String?
  isPublished Boolean  @default(false)
  category    String?
  level       String   @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  duration    String?
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User          @relation("CourseAuthor", fields: [authorId], references: [id])
  modules     Module[]
  enrollments Enrollment[]
  comments    Comment[]
  challenges  Challenge[]
  templates   CourseTemplate[]
  forumPosts  ForumPost[]
  paths       LearningPathCourse[]
  certificates Certificate[]
  surveys     Survey[]
  teachers    CourseTeacher[]
  flashcards  CourseFlashcard[]
}

model Module {
  id        String   @id @default(cuid())
  title     String
  order     Int
  courseId   String
  createdAt DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submodules Submodule[]
  lessons Lesson[]
  quizzes Quiz[]

  @@unique([courseId, order])
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  description String?
  content     String?  // Markdown content
  task        String?  // Assignment / task description
  order       Int
  isFree      Boolean  @default(false)
  moduleId    String
  submoduleId String?
  createdAt   DateTime @default(now())

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submodule Submodule?      @relation(fields: [submoduleId], references: [id], onDelete: SetNull)
  progress LessonProgress[]
  comments Comment[]
  files    LessonFile[]
  exercises CodeExercise[]
  terminalCommands TerminalCommand[]

  @@unique([moduleId, order])
}

model LessonFile {
  id        String   @id @default(cuid())
  name      String
  url       String
  size      Int?
  type      String?
  lessonId  String
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ─── Enrollment & Progress ──────────────────────────────

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

// ─── Quizzes ────────────────────────────────────────────

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  isAdaptive  Boolean  @default(false) // Adaptive quiz flag
  isTimed     Boolean  @default(false) // Timed exam mode
  timeLimit   Int?     // Time limit in seconds
  moduleId    String
  createdAt   DateTime @default(now())

  module    Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id            String   @id @default(cuid())
  question      String
  options       String   // JSON array of options
  correctIndex  Int      // Index of correct answer
  explanation   String?
  difficulty    String   @default("MEDIUM") // EASY | MEDIUM | HARD
  order         Int
  quizId        String
  createdAt     DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int      // Number of correct answers
  total     Int      // Total questions
  answers   String   // JSON array of user answers
  passed    Boolean  @default(false)
  startedAt DateTime? // When the timed quiz was started
  timeSpent Int?      // Actual time spent in seconds
  createdAt DateTime @default(now())

  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
}

// ─── Challenges ─────────────────────────────────────────

model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String
  difficulty  String   @default("EASY") // EASY | MEDIUM | HARD
  points      Int      @default(10)
  courseId    String
  createdAt   DateTime @default(now())

  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions ChallengeSubmission[]
}

model ChallengeSubmission {
  id        String   @id @default(cuid())
  userId    String
  challengeId String
  content   String   // User's solution/code
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  feedback  String?
  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

// ─── Achievements ───────────────────────────────────────

model Achievement {
  id          String   @id @default(cuid())
  name        String   @unique
  title       String
  description String
  icon        String   // Emoji or icon name
  category    String   @default("MILESTONE") // MILESTONE | COURSE | QUIZ | CHALLENGE | SPECIAL
  criteria    String   // JSON: { type: "enrollments" | "lessons" | "quizzes" | "challenges", count: N }
  points      Int      @default(10)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// ─── Comments (threaded) ───────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  courseId   String?
  lessonId  String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson   Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  parent   Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")
}

// ─── Forum (per course) ────────────────────────────────

model ForumPost {
  id          String   @id @default(cuid())
  title       String
  content     String
  courseId     String
  userId      String
  isPinned    Boolean  @default(false)
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies  ForumReply[]
}

model ForumReply {
  id        String   @id @default(cuid())
  content   String
  postId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Staff Contact ─────────────────────────────────────

model StaffMessage {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    String   @default("PENDING") // PENDING | READ | REPLIED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ─── Chat / Messages ────────────────────────────────────

model Message {
  id         String    @id @default(cuid())
  content    String
  senderId   String
  receiverId String?
  groupId    String?
  fileUrl    String?
  fileName   String?
  fileType   String?
  isPinned   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  sender    User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User?         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  group     Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// ─── Contacts ───────────────────────────────────────────

model Contact {
  id        String   @id @default(cuid())
  userId    String
  contactId String
  status    String   @default("PENDING") // PENDING | ACCEPTED | BLOCKED
  createdAt DateTime @default(now())

  owner   User @relation("ContactOwner", fields: [userId], references: [id], onDelete: Cascade)
  contact User @relation("ContactTarget", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
}

// ─── Group Invite Links ────────────────────────────────

model GroupInvite {
  id        String   @id @default(cuid())
  groupId   String
  token     String   @unique
  createdById String
  expiresAt DateTime?
  maxUses   Int?
  useCount  Int      @default(0)
  createdAt DateTime @default(now())

  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

// ─── Student Groups (private, invite-only) ──────────────

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User?           @relation(fields: [createdById], references: [id])
  members   GroupMembership[]
  messages  Message[]
  calls     CallSession[]
  invites   GroupInvite[]
  projects  CollaborativeProject[]
}

model GroupMembership {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  role     String   @default("MEMBER") // ADMIN | MODERATOR | MEMBER
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

// ─── Course Templates (project starter files) ──────────

model CourseTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  fileName    String
  fileUrl     String
  fileSize    Int?
  language    String?  // e.g. "javascript", "python", "html"
  courseId     String
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// ─── Code Exercises (interactive) ──────────────────────

model CodeExercise {
  id           String   @id @default(cuid())
  title        String
  description  String
  language     String   @default("javascript") // javascript | python | html | css
  starterCode  String?  // Initial code template
  solution     String?  // Expected solution
  testCases    String   // JSON: [{ input: ..., expected: ..., description: ... }]
  difficulty   String   @default("EASY") // EASY | MEDIUM | HARD
  points       Int      @default(10)
  lessonId     String
  createdAt    DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ─── Terminal Commands (virtual terminal) ──────────────

model TerminalCommand {
  id          String   @id @default(cuid())
  command     String
  description String?
  output      String   // Expected output
  explanation String?
  order       Int
  lessonId    String
  createdAt   DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
}

// ─── Technical Glossary ────────────────────────────────

model GlossaryTerm {
  id          String   @id @default(cuid())
  term        String   @unique
  definition  String
  example     String?
  category    String?  // e.g. "javascript", "react", "css", "general"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reviews     FlashcardReview[]
}

// ─── Learning Paths (course playlists) ─────────────────

model LearningPath {
  id            String   @id @default(cuid())
  title         String
  description   String?
  thumbnail     String?
  level         String   @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  quizQuestions String?  // JSON: [{ question, options: string[], correctIndex }]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  courses LearningPathCourse[]
  quizResults PathQuizResult[]
}

model LearningPathCourse {
  id         String   @id @default(cuid())
  pathId     String
  courseId    String
  order      Int
  createdAt  DateTime @default(now())

  path   LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([pathId, courseId])
  @@unique([pathId, order])
}

// ─── Certificates ──────────────────────────────────────

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  courseId     String
  completedAt DateTime @default(now())
  certificateNumber String @unique // e.g. "INDX-2024-XXXX"

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ─── Notifications ─────────────────────────────────────

model UserNotification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO | ACHIEVEMENT | MESSAGE | FORUM | SYSTEM
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Peer Matching ─────────────────────────────────────

model PeerMatch {
  id        String   @id @default(cuid())
  userId    String
  peerId    String
  status    String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  message   String?
  createdAt DateTime @default(now())

  user    User @relation("PeerUser", fields: [userId], references: [id], onDelete: Cascade)
  peer    User @relation("PeerTarget", fields: [peerId], references: [id], onDelete: Cascade)

  @@unique([userId, peerId])
}

// ─── Call Sessions (WebRTC) ────────────────────────────

model CallSession {
  id        String   @id @default(cuid())
  groupId   String?
  callerId  String
  type      String   @default("AUDIO") // AUDIO | VIDEO
  status    String   @default("ACTIVE") // ACTIVE | ENDED
  startedAt DateTime @default(now())
  endedAt   DateTime?

  caller  User    @relation(fields: [callerId], references: [id], onDelete: Cascade)
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// ─── Reactions (likes/hearts) ───────────────────────────

model Reaction {
  id         String   @id @default(cuid())
  type       String   @default("LIKE") // LIKE | HEART
  userId     String
  targetType String   // MESSAGE | FORUM_POST | FORUM_REPLY | COMMENT
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
}

// ─── Content Moderation (reports) ───────────────────────

model Report {
  id           String    @id @default(cuid())
  reporterId   String
  targetType   String    // MESSAGE | FORUM_POST | FORUM_REPLY | COMMENT
  targetId     String
  reason       String    // SPAM | INAPPROPRIATE | HARASSMENT | OTHER
  description  String?
  status       String    @default("PENDING") // PENDING | REVIEWED | DISMISSED
  reviewedById String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReportReviewer", fields: [reviewedById], references: [id])
}

// ─── Post-Course Surveys ────────────────────────────────

model Survey {
  id          String   @id @default(cuid())
  courseId     String
  title       String
  description String?
  questions   String   // JSON: [{ question, type: "stars"|"text"|"choice", options? }]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]
}

model SurveyResponse {
  id        String   @id @default(cuid())
  surveyId  String
  userId    String
  answers   String   // JSON: { questionIndex: answer }
  rating    Int?     // Overall rating 1-5
  comment   String?
  createdAt DateTime @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([surveyId, userId])
}

// ─── Flashcards / Spaced Repetition ─────────────────────

model FlashcardReview {
  id           String   @id @default(cuid())
  userId       String
  glossaryId   String
  quality      Int      // 0-5 (SM-2 quality rating)
  interval     Int      // Days until next review
  easeFactor   Float    // SM-2 ease factor
  nextReview   DateTime // When to review next
  reviewCount  Int      @default(0)
  lastReviewed DateTime?
  createdAt    DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  term GlossaryTerm @relation(fields: [glossaryId], references: [id], onDelete: Cascade)

  @@unique([userId, glossaryId])
}

// ─── Collaborative Projects ─────────────────────────────

model CollaborativeProject {
  id          String   @id @default(cuid())
  name        String
  description String?
  language    String   @default("javascript")
  code        String   @default("")
  groupId     String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  group     Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  members   ProjectMember[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("EDITOR") // EDITOR | VIEWER
  joinedAt  DateTime @default(now())

  project CollaborativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// ─── Path Quiz Results ──────────────────────────────────

model PathQuizResult {
  id                String   @id @default(cuid())
  userId            String
  pathId            String
  answers           String   // JSON array of answers
  score             Int
  recommendedLevel  String   // BEGINNER | INTERMEDIATE | ADVANCED
  createdAt         DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId])
}

// ─── Onboarding ─────────────────────────────────────────

model UserOnboarding {
  id             String   @id @default(cuid())
  userId         String   @unique
  completedSteps String   @default("[]") // JSON array of completed step IDs
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
